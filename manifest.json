{
  "manifest_version": 3,
  "name": "X Blur Mode",
  "version": "1.0.1",
  "description": "Hide your handle, names, avatars, DMs and unread counts on x.com and twitter.com so nobody can read over your shoulder.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Blur Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
